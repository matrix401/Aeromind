# Copy to .env.local and fill in real values. Never commit .env.local.
# No secrets are hardcoded in the app — everything reads from these.

# Lead delivery destination (Phase 5). Exactly one adapter should be
# configured once the owner picks a destination — see src/lib/validation.ts
# and the Phase 5 lead-integration guide for the adapter interface.
LEAD_WEBHOOK_URL=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
RESEND_API_KEY=

# Analytics / tracking (Phase 12)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=

# WhatsApp click-to-chat number, digits only with country code (used to
# build wa.me links) — mirrors business.contact.whatsappHref in
# src/config/business.ts once verified.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Search Console verification (Phase 10)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
